// Subconjunto do schema do Agent-Api (mesmo Postgres, schema `public`). Migrations
// só existem em Agent-Api/prisma/migrations. Qualquer mudança de coluna precisa ser
// espelhada manualmente aqui. Rodar apenas `prisma generate`, nunca `prisma migrate`.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id            String   @id
  name          String
  slug          String
  logo          String?
  createdAt     DateTime
  metadata      String?
  cnpj          String
  status        String?  @default("ACTIVE")
  tokenAcessApi String?  @unique

  agents           Agent[]
  whatsappChannels Channel[]
  serviceIslands   ServiceIsland[]
  targets          Target[]

  @@unique([slug])
  @@map("organization")
}

model Agent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  isActive       Boolean      @default(true)

  processingMessage        String
  transferMessage          String
  unsupportedFormatMessage String
  blockedMessage           String
  outOfHoursMessage        String
  outOfHoursEnabled        Boolean @default(true)
  closingMessage           String
  closingEnabled           Boolean @default(true)
  errorMessage             String
  errorEnabled             Boolean @default(true)

  defaultQueueId String?
  defaultQueue   Queue?  @relation(fields: [defaultQueueId], references: [id], onDelete: SetNull)

  personality String?
  ragEnabled  Boolean @default(false)

  /// Vai no payload do AI-Worker — true = encaminha pro atendimento humano
  /// ao terminar a coleta/funções; false = finaliza a conversa.
  handoffAfterFunctions Boolean @default(false)

  /// RGBS (Receives, Generates, Breaks and Sends) — aba "Função" do Agent
  /// Console. Ligado: o prompt pede pro agente quebrar a resposta com [QB] e
  /// o AI-Worker envia cada parte como uma mensagem separada, esperando antes
  /// de cada uma um tempo conforme o tamanho dela (em segundos):
  /// até 40 caracteres = timeSmall, até 100 = timeMedium, acima = timeLarge.
  rgbsEnabled Boolean @default(false)
  timeSmall   Int     @default(5)
  timeMedium  Int     @default(10)
  timeLarge   Int     @default(15)

  /// Últimas mensagens da sessão que vão pro modelo — ver
  /// Agent-Api/prisma/schema.prisma (dono canônico).
  limitHistoryToAgent Int @default(6)

  /// OBSOLETO — o catálogo virou AgentFeature (type CATALOG), migrado na
  /// 20261016030000_add_agent_features. Colunas mantidas só pra não quebrar
  /// serviços ainda não reimplantados; nada lê mais daqui.
  catalogEnabled Boolean @default(false)
  catalogId      String?
  catalogName    String?
  catalogPrompt  String?

  /// Cifrados (AES-256-GCM) — decifrados aqui na hora de montar o payload
  /// pro AI-Worker (ver src/infrastructure/crypto/token-cipher.ts e
  /// application/webhook/webhook-service.ts#agentPayload). Nunca decifrar em
  /// nenhum outro lugar nem logar o valor em claro.
  openaiTokenEncrypted String?
  geminiTokenEncrypted String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  whatsappChannels Channel[]
  metadataFields   AgentMetadataField[]
  functions        AgentFunction[]
  features         AgentFeature[]

  @@index([organizationId])
  @@index([defaultQueueId])
}

/// Espelho de Agent-Api/prisma/schema.prisma (dono canônico da migration) —
/// vai no payload do AI-Worker (agentPayload.functions).
enum AgentFunctionType {
  CALENDAR_EVENT
  KANBAN_CARD
}

model AgentFunction {
  id      String            @id @default(cuid())
  agentId String
  agent   Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  type    AgentFunctionType

  runAtStart       Boolean @default(false)
  runAfterMetadata Boolean @default(false)

  /// Só KANBAN_CARD: estágio do Kanban em que o card nasce (null = "Início").
  /// Espelho só da coluna — a relação com StagesCrm fica no Agent-Api.
  crmStageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, type])
  @@index([agentId])
}

/// Espelho de Agent-Api/prisma/schema.prisma (dono canônico da migration) —
/// os ativos vão no payload do AI-Worker (agentPayload.metadataFields).
model AgentMetadataField {
  id      String @id @default(cuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  name        String
  nameToAgent String
  rule        String
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, nameToAgent])
  @@index([agentId])
}

model Channel {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String?
  agent          Agent?       @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// Decide se handleInboundMessage manda pro agente (true) ou direto pro
  /// atendimento humano via idServiceIslandDefault (false) — ver webhook-service.ts.
  openAgent              Boolean @default(false)
  /// Id de uma Queue (fila) — usado quando openAgent=false.
  idServiceIslandDefault String?

  phoneNumberId   String  @unique
  displayNumber   String
  wabaId          String  @unique
  metaAccessToken String?

  /// Palavras/frases-chave de reset de jornada — ver Agent-Api/prisma/schema.prisma
  /// (dono canônico da migration) e AI-Worker/Piloto/consumer.py (quem consome).
  wordsToReset String[] @default([])
  /// Mensagem enviada ao contato depois do reset de jornada. null/vazio = usa
  /// a mensagem padrão fixa no Piloto (consumer.py).
  resetMessage String?

  /// Frases que bloqueiam o contato de futuras campanhas deste canal quando
  /// ele responde com uma delas a um disparo — ver Agent-Api/prisma/schema.prisma
  /// (dono canônico) e application/webhook/campaign-response-service.ts.
  wordsToBlockCampaign    String[] @default([])
  /// Liga/desliga a avaliação de wordsToBlockCampaign para este canal.
  useWordsToBlockCampaign Boolean  @default(false)

  /// Tempo (segundos) da janela de agrupamento de mensagens deste canal — ver
  /// Agent-Api/prisma/schema.prisma (dono canônico) e debounce-service.ts.
  messageWaitSeconds Int @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceIsland        ServiceIsland?
  targets              Target[]
  targetBlockCampaigns TargetBlockCampaign[]

  @@index([organizationId])
  @@index([agentId])
}

model ServiceIsland {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  whatsappChannelId   String       @unique
  whatsappChannel     Channel      @relation(fields: [whatsappChannelId], references: [id], onDelete: Cascade)
  name                String
  allowActiveDispatch Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  queues                Queue[]
  preConfiguredMessages PreConfiguredMessage[]

  @@index([organizationId])
}

/// Mensagem pronta gerida no Agent Console e usada pelo atendente no Desk
/// Console como atalho ao responder um ticket. Ver Agent-Api/prisma/schema.prisma
/// (schema canônico) pro comentário completo.
model PreConfiguredMessage {
  id              String        @id @default(cuid())
  serviceIslandId String
  serviceIsland   ServiceIsland @relation(fields: [serviceIslandId], references: [id], onDelete: Cascade)
  name            String
  content         String

  queues Queue[] @relation("PreConfiguredMessageQueues")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceIslandId, name])
  @@index([serviceIslandId])
}

model Queue {
  id              String        @id @default(cuid())
  serviceIslandId String
  serviceIsland   ServiceIsland @relation(fields: [serviceIslandId], references: [id], onDelete: Cascade)
  name            String

  businessHoursEnabled Boolean @default(false)
  businessHoursStart   String?
  businessHoursEnd     String?
  businessDays         Int[]   @default([1, 2, 3, 4, 5])

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  defaultForAgents      Agent[]
  preConfiguredMessages PreConfiguredMessage[] @relation("PreConfiguredMessageQueues")

  @@index([serviceIslandId])
}

enum TargetStatus {
  AI
  HUMAN
  FINISHED
}

model Target {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  whatsappChannelId String
  whatsappChannel   Channel      @relation(fields: [whatsappChannelId], references: [id], onDelete: Cascade)

  /// Business-Scoped User ID (contacts[].user_id) — vínculo principal do
  /// contato, sempre presente desde abr/2026. Nullable só pra Target
  /// criado manualmente antes de o contato mandar mensagem de verdade.
  bsuid    String?
  /// wa_id da Meta — agora opcional (omitido quando o contato ativa
  /// @username e não há troca recente de telefone).
  waId     String?
  name     String?
  email    String?
  metadata Json?

  status             TargetStatus @default(AI)
  firstInteractionAt DateTime     @default(now())
  lastInteractionAt  DateTime?

  /// Ids de Agent que este contato está bloqueado de falar — ver
  /// application/webhook/webhook-service.ts.
  blockedAgentIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messagingSessions    MessagingSession[]
  campaignTargets      CampaignTarget[]
  targetBlockCampaigns TargetBlockCampaign[]
  cardCrm              CardCrm?

  @@unique([organizationId, whatsappChannelId, bsuid])
  @@unique([organizationId, whatsappChannelId, waId])
  @@index([organizationId])
  @@index([whatsappChannelId])
}

/// Subconjunto mínimo — só o suficiente pra crm-card-service.ts compilar. Ver
/// Agent-Api/prisma/schema.prisma (schema canônico) pro modelo completo.
model CrmToBusiness {
  id             String @id
  organizationId String @unique

  stagesCrm StagesCrm[]
}

model StagesCrm {
  id              String        @id
  crmToBusinessId String
  crmToBusiness   CrmToBusiness @relation(fields: [crmToBusinessId], references: [id])
  isDefault       Boolean

  cards CardCrm[]
}

model CardCrm {
  id              String        @id @default(cuid())
  targetId        String        @unique
  target          Target        @relation(fields: [targetId], references: [id], onDelete: Cascade)
  crmToBusinessId String
  stagesCrmId     String?
  stagesCrm       StagesCrm?    @relation(fields: [stagesCrmId], references: [id], onDelete: SetNull)
}

/// Subconjunto mínimo — só o suficiente pra CampaignTarget compilar. Ver
/// Agent-Api/prisma/schema.prisma (schema canônico) pro modelo completo.
model Campaign {
  id String @id @default(cuid())

  targets CampaignTarget[]
}

/// Uma linha por contato disparado dentro de uma campanha. Usado aqui só
/// pra vincular a resposta do cliente ao disparo (ver
/// application/webhook/campaign-response-service.ts) — demais colunas ficam
/// de fora por não serem lidas/escritas neste serviço.
model CampaignTarget {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  targetId   String
  target     Target   @relation(fields: [targetId], references: [id], onDelete: Cascade)

  respondedCampaign Boolean @default(false)
  campaignResponse  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([targetId, respondedCampaign])
}

/// Bloqueio automático de um contato para campanhas de um canal específico —
/// ver Agent-Api/prisma/schema.prisma (schema canônico) pro comentário
/// completo. Este serviço só cria linhas aqui (nunca lê).
model TargetBlockCampaign {
  id                String  @id @default(cuid())
  targetId          String
  target            Target  @relation(fields: [targetId], references: [id], onDelete: Cascade)
  whatsappChannelId String
  whatsappChannel   Channel @relation(fields: [whatsappChannelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([targetId, whatsappChannelId])
  @@index([whatsappChannelId])
}

enum SessionOrigin {
  CUSTOMER_MESSAGE
  CAMPAIGN_TEMPLATE
}

model MessagingSession {
  id                String @id @default(cuid())
  targetId          String
  target            Target @relation(fields: [targetId], references: [id], onDelete: Cascade)
  whatsappChannelId String

  createdVia             SessionOrigin @default(CUSTOMER_MESSAGE)
  startedAt              DateTime      @default(now())
  lastCustomerMessageAt  DateTime      @default(now())
  lastAttendantMessageAt DateTime?

  createdAt DateTime @default(now())

  @@index([targetId])
  @@index([whatsappChannelId])
}

model ProcessedInboundMessage {
  id                String   @id @default(cuid())
  externalMessageId String   @unique
  whatsappChannelId String
  processedAt       DateTime @default(now())

  @@index([whatsappChannelId])
}

/// Rastreamento de uma mensagem passando pelos serviços da mensageria — ver
/// Agent-Api/prisma/schema.prisma (schema canônico) pro comentário completo
/// e MENSAGERIA.md pro mapa das filas. Sem FK: messageId é um ponteiro solto
/// (Mongo _id da mensagem, ou o id disponível naquele estágio).
model MessageLog {
  id         String   @id @default(cuid())
  messageId  String
  createdAt  DateTime @default(now())
  messageLog String
  stagio     String

  @@index([messageId])
  @@index([messageLog, stagio])
}

/// Funcionalidades de mensagem do agente (aba "Função" › "Adicionar
/// funcionalidade" no Agent Console). Cada linha é uma instância configurada
/// — pode haver várias do mesmo tipo (ex: dois catálogos, vários botões de
/// link), exceto LOCATION_REQUEST, CONTEXTUAL_REPLY e PAYMENT (uma por
/// agente). `prompt` = quando o agente deve usar; `config` = campos do tipo
/// (validados em Agent-Api/agent-feature-validation.ts). O Inbound-Service
/// manda todas no payload e o AI-Worker vira cada uma em ferramenta + prompt.
/// PAYMENT existe só no backend (não aparece no Console por enquanto).
enum AgentFeatureType {
  CATALOG
  PRODUCT_CAROUSEL
  CTA_URL
  LIST
  REPLY_BUTTONS
  MEDIA_CAROUSEL
  LOCATION_REQUEST
  CONTEXTUAL_REPLY
  LINK_PREVIEW
  PAYMENT
  FLOW
}

model AgentFeature {
  id      String           @id @default(cuid())
  agentId String
  agent   Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  type    AgentFeatureType
  name    String
  prompt  String           @default("")
  config  Json             @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
}
